# Copy this file to .env and fill in real values. .env is gitignored.
#
# For a *quick local test only*, docker-compose.yml ships with insecure
# fallback values for POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB/SECRET_KEY/
# ENCRYPTION_KEY, so `docker compose up`/`podman compose up` will still start
# even if you skip this step. Still copy this file and set real values
# before using VoidSSH for anything beyond a throwaway localhost try-out.

# --- Database ---
POSTGRES_USER=voidssh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voidssh

# --- Backend ---
FLASK_ENV=development
# Flask session/JWT signing key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Key used to encrypt stored SSH credentials at rest (any random string; it is
# deterministically derived into a Fernet key) - generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-me
# Require HTTPS before the browser will send back the session/CSRF cookies.
# Defaults to true; only disable for the plain-http dev workflow (the dev
# compose override already does this for you). See README for the "prod"
# profile, which terminates real TLS via a reverse proxy.
SESSION_COOKIE_SECURE=true

# --- Email (optional) ---
# Password-reset links are logged by the backend instead of emailed if
# SMTP_HOST is left unset - fine for local/dev use. Set these to send real
# email in a production deployment.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=voidssh@example.com
# SMTP_USE_TLS=true
# Origin the backend puts into emailed links (e.g. password reset). Should
# match the real address users load the frontend from.
FRONTEND_URL=http://localhost:5173

# --- Frontend ---
# URL the frontend uses to reach the backend API
VITE_API_URL=http://localhost:5000
# Comma-separated list of origins the backend accepts cross-origin
# session-cookie requests from (also used for the Socket.IO handshake)
CORS_ORIGINS=http://localhost:5173

# --- Reverse proxy ("prod" compose profile) ---
# Domain Caddy requests/self-signs a TLS cert for; "localhost" gets a
# locally-trusted cert via Caddy's internal CA, good enough to test the
# HTTPS/Secure-cookie path without a real domain.
PROXY_DOMAIN=localhost
# Host port Caddy's HTTPS listener binds to. Defaults to 8443 because
# rootless Podman can't bind :443 without a sysctl change; a rootful or
# production host can set this to 443.
PROXY_PORT=8443
